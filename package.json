{
  "name": "storeos",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @storeos/contracts build && pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @storeos/api test:integration",
    "db:generate": "pnpm --filter @storeos/api prisma:generate",
    "db:migrate": "pnpm --filter @storeos/api prisma:migrate",
    "db:deploy": "pnpm --filter @storeos/api prisma:deploy",
    "db:seed": "pnpm --filter @storeos/api prisma:seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@nestjs/core",
      "argon2",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
