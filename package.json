{
  "name": "storeos",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @storeos/api prisma:generate",
    "db:migrate": "pnpm --filter @storeos/api prisma:migrate",
    "db:seed": "pnpm --filter @storeos/api db:seed",
    "test:int": "pnpm --filter @storeos/api test:int"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "js-yaml@>=5.0.0 <5.4.1": "^5.4.1",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "multer@>=2.0.0 <2.5.0": "^2.5.0",
      "qs@>=6.7.0 <6.16.1": "^6.16.1",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9"
    }
  }
}
