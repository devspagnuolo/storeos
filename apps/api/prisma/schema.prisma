// STOREOS — modelo de dados v2 (multiempresa).
// Regras: toda entidade de negócio carrega storeId; valores monetários são Decimal(14,2);
// PII sensível (documentos, segredos) é guardada criptografada (*Enc) com hash de busca (*Hash).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

