  ACTIVE
  SUSPENDED
  CLOSED
}

enum StorePlan {
  FREE
  GROWTH
  SCALE
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum OneTimeTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  USER_INVITE
