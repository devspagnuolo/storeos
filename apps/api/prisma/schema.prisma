generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  NEW
  AWAITING_PAYMENT
  PAID
  PICKING
  INVOICED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
}

enum PaymentMethod {
  PIX
  BOLETO
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model Store {
  id                     String                  @id @default(uuid())
  name                   String
  slug                   String                  @unique
  logoUrl                String?                 @db.Text
  faviconUrl             String?                 @db.Text
  themeConfig            Json                    @default("{}")
  whatsappNumber         String?
  whatsappMessage        String?
  /// CEP de onde a loja despacha (8 dígitos). Sem ele vale SHIPPING_ORIGIN_ZIP do servidor.
  shippingOriginZip      String?
  marketingConfig        Json?
  draftThemeConfig       Json?
  storefrontVersion      Int                     @default(0)
  storefrontPublishedAt  DateTime?
  storefrontPublications StorefrontPublication[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  users                  User[]
  products               Product[]
  categories             Category[]
  shippingRules          ShippingRule[]
  customers              Customer[]
  orders                 Order[]
  outboxEvents           OutboxEvent[]
  coupons                Coupon[]
  brands                 Brand[]
  collections            Collection[]
  pages                  Page[]
  menus                  Menu[]
  banners                Banner[]
  mediaAssets            MediaAsset[]
  blingConnection        BlingConnection?
  blingInvoices          BlingInvoice[]
  blingOrderSyncs        BlingOrderSync[]
  blingImports           BlingImport[]
  subscribers            NewsletterSubscriber[]
  emailLogs              EmailLog[]
  promotions             Promotion[]
  stockMovements         StockMovement[]
  domains                StoreDomain[]
  abandonedCarts         AbandonedCart[]
  checkoutDrafts         CheckoutDraft[]
  emailTemplates         EmailTemplate[]
  emailCampaigns EmailCampaign[]
  warehouses     Warehouse[]
  loyaltyConfig LoyaltyConfig?
  businessProfile Json?
  /// Vitrine aberta ao público. Lojas criadas pelo cadastro começam fechadas até o lojista publicar.
  storefrontOpen Boolean @default(true)
  productReviews ProductReview[]
  redirects Redirect[]
  automationRules AutomationRule[]
}

model User {
  id            String         @id @default(uuid())
  storeId       String
  email         String
  passwordHash  String
  name          String
  status        UserStatus     @default(ACTIVE)
  mfaEnabled    Boolean        @default(false)
  mfaSecretEnc  String?
  mfaRecovery   String[]       @default([])
  mfaLastStep   Int?
  emailVerifiedAt         DateTime?
  verificationHash        String?
  verificationExpiresAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  roles         UserRole[]
  refreshTokens RefreshToken[]

  @@unique([storeId, email])
  @@index([storeId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  userAgent  String?
  ip         String?
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId])
}

model Product {
  id             String              @id @default(uuid())
  storeId        String
  status         ProductStatus       @default(DRAFT)
  name           String
  slug           String
  sku            String
  description    String?
  price          Decimal             @db.Decimal(14, 2)
  currency       String              @default("BRL")
  brandId        String?
  seoTitle       String?
  seoDescription String?
  weightGrams    Int?
  widthCm        Int?
  heightCm       Int?
  lengthCm       Int?
  /// Dados fiscais para a nota: NCM (8 dígitos), CEST (7), GTIN/EAN (8, 12, 13 ou 14), origem da mercadoria (0 a 8) e unidade.
  ncm            String?
  cest           String?
  gtin           String?
  taxOrigin      Int?
  unit           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  store          Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants       ProductVariant[]
  images         ProductImage[]
  inventory      Inventory[]
  orderItems     OrderItem[]
  categories     ProductCategory[]
  brand          Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  collections    CollectionProduct[]
  reviews        ProductReview[]

  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@index([brandId])
  @@index([storeId, status])
  @@index([storeId, createdAt])
}

model Category {
  id              String            @id @default(uuid())
  storeId         String
  name            String
  slug            String
  description     String?
  position        Int               @default(0)
  parentId        String?
  bannerUrl       String?
  bannerMobileUrl String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent          Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]        @relation("CategoryTree")
  products        ProductCategory[]

  @@unique([storeId, slug])
  @@index([storeId, position])
  @@index([parentId])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductVariant {
  id         String      @id @default(uuid())
  productId  String
  sku        String
  price      Decimal?    @db.Decimal(14, 2)
  attributes Json
  position   Int         @default(0)
  active     Boolean     @default(true)
  gtin       String?
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory[]

  @@unique([productId, sku])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

enum StockMovementType {
  INITIAL
  ADJUSTMENT
  SALE
  RETURN
}

model StockMovement {
  id          String            @id @default(uuid())
  storeId     String
  productId   String
  variantId   String?
  type        StockMovementType
  delta       Int
  balance     Int
  reason      String?
  orderNumber String?
  actorId     String?
  createdAt   DateTime          @default(now())
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([storeId, productId, createdAt])
}

model Inventory {
  id           String          @id @default(uuid())
  storeId      String
  productId    String
  variantId    String?
  quantity     Int             @default(0)
  reserved     Int             @default(0)
  reorderPoint Int             @default(0)
  updatedAt    DateTime        @updatedAt
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseStocks WarehouseStock[]

  @@unique([storeId, productId, variantId])
  @@index([productId])
}

model Customer {
  id             String         @id @default(uuid())
  storeId        String
  email          String
  name           String
  phone          String?
  /// CPF/CNPJ (só dígitos), informado no checkout para a nota fiscal e o pedido no ERP.
  document       String?
  notes          String?
  tags           String[]       @default([])
  marketingOptIn Boolean        @default(false)
  anonymizedAt   DateTime?
  loyaltyEntries LoyaltyEntry[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses      Address[]
  orders         Order[]
  noteEntries    CustomerNote[]

  @@unique([storeId, email])
}

model Address {
  id         String   @id @default(uuid())
  customerId String
  zipCode    String
  street     String
  number     String
  city       String
  state      String
  country    String   @default("BR")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Order {
  id                String            @id @default(uuid())
  storeId           String
  customerId        String?
  number            String
  status            OrderStatus       @default(NEW)
  subtotal          Decimal           @db.Decimal(14, 2)
  discount          Decimal           @default(0) @db.Decimal(14, 2)
  shipping          Decimal           @default(0) @db.Decimal(14, 2)
  total             Decimal           @db.Decimal(14, 2)
  currency          String            @default("BRL")
  shippingAddress   Json?
  shippingMethod    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer          Customer?         @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  payments          Payment[]
  timeline          OrderTimeline[]
  fulfillment       Fulfillment?
  couponCode        String?
  promotionDiscount Decimal           @default(0) @db.Decimal(14, 2)
  promotions        Json?
  redemption        CouponRedemption?
  loyaltyEntries    LoyaltyEntry[]
  blingSync         BlingOrderSync?
  blingInvoice      BlingInvoice?
  refunds           Refund[]

  @@unique([storeId, number])
  @@index([storeId, status, createdAt])
  @@index([customerId])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String?
  variantId String?
  sku       String
  name      String
  quantity  Int
  unitPrice Decimal  @db.Decimal(14, 2)
  total     Decimal  @db.Decimal(14, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  provider      String
  method        PaymentMethod @default(PIX)
  status        PaymentStatus @default(PENDING)
  transactionId String?
  amount        Decimal       @db.Decimal(14, 2)
  instructions  Json?
  expiresAt     DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([provider, transactionId])
  @@index([status, expiresAt])
}

model OrderTimeline {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  message   String?
  actorId   String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OutboxEvent {
  id            String    @id @default(uuid())
  storeId       String
  aggregateType String
  aggregateId   String
  eventName     String
  payload       Json
  occurredAt    DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([publishedAt, occurredAt])
}

/// Regra de frete por região: vale para as UFs listadas (vazio = todo o Brasil).
model ShippingRule {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  states    String[]
  price     Decimal  @db.Decimal(14, 2)
  freeAbove Decimal? @db.Decimal(14, 2)
  freeOnly  Boolean  @default(false)
  minDays   Int
  maxDays   Int
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, active, position])
}

/// Immutable published snapshots; restoring creates a draft first.
model StorefrontPublication {
  id        String   @id @default(uuid())
  storeId   String
  version   Int
  config    Json
  actorId   String?
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, version])
  @@index([storeId, createdAt])
}

enum ThemePackageStatus {
  DRAFT
  LISTED
  DEPRECATED
}

enum ThemeReleaseStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

enum ThemeInstallationStatus {
  ACTIVE
  INACTIVE
  REMOVED
}

enum ThemeDraftStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Curated theme identity. Releases are immutable and global; tenant content is stored separately.
model ThemePackage {
  id          String            @id @default(uuid())
  key         String            @unique
  name        String
  description String?           @db.Text
  status      ThemePackageStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  releases    ThemeRelease[]
}

/// Immutable, versioned manifest for an installable theme package.
model ThemeRelease {
  id          String             @id @default(uuid())
  packageId   String
  version     String
  manifest    Json
  manifestHash String
  status      ThemeReleaseStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime           @default(now())
  package     ThemePackage       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  installations ThemeInstallation[]

  @@unique([packageId, version])
  @@index([packageId, status])
}

/// A store-scoped installation of one immutable release. Switching the active installation is
/// enforced in a serializable application transaction, preserving single-active-theme semantics.
model ThemeInstallation {
  id        String                  @id @default(uuid())
  storeId   String
  releaseId String
  status    ThemeInstallationStatus @default(INACTIVE)
  installedAt DateTime              @default(now())
  updatedAt DateTime                @updatedAt
  release   ThemeRelease            @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  drafts    ThemeDraft[]
  publications ThemeEnginePublication[]

  @@unique([storeId, releaseId])
  @@unique([id, storeId])
  @@index([storeId, status])
}

/// Mutable tenant draft with optimistic revision control. It does not replace Store.draftThemeConfig.
model ThemeDraft {
  id             String          @id @default(uuid())
  storeId        String
  installationId String
  revision       Int             @default(1)
  document       Json
  status         ThemeDraftStatus @default(DRAFT)
  updatedBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  installation   ThemeInstallation @relation(fields: [installationId, storeId], references: [id, storeId], onDelete: Cascade)

  @@index([storeId, installationId, updatedAt])
}

/// Immutable publication snapshots for the new engine; legacy storefront snapshots remain readable.
model ThemeEnginePublication {
  id             String   @id @default(uuid())
  storeId        String
  installationId String
  version        Int
  document       Json
  documentHash   String
  actorId        String?
  createdAt      DateTime @default(now())
  installation   ThemeInstallation @relation(fields: [installationId, storeId], references: [id, storeId], onDelete: Cascade)

  @@unique([storeId, version])
  @@index([storeId, createdAt])
}

/// Trilha de auditoria imutável: um gatilho no banco impede UPDATE e DELETE. Sem FK, para sobreviver à remoção de loja ou usuário.
model AuditLog {
  id         String   @id @default(uuid())
  storeId    String?
  actorId    String?
  action     String
  entity     String?
  entityId   String?
  outcome    String
  statusCode Int?
  ip         String?
  userAgent  String?
  requestId  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, actorId, createdAt(sort: Desc)])
  @@index([storeId, entity, entityId])
}

/// Dados logísticos e fiscais do pedido (separação, nota, expedição, entrega, devolução). Um por pedido.
model Fulfillment {
  id            String    @id @default(uuid())
  orderId       String    @unique
  storeId       String
  pickedAt      DateTime?
  invoiceNumber String?
  invoiceKey    String?
  invoicedAt    DateTime?
  carrier       String?
  trackingCode  String?
  trackingUrl   String?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  returnReason  String?
  returnedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId, trackingCode])
}

enum RefundMode {
  GATEWAY
  MANUAL
}

enum RefundStatus {
  PENDING
  DONE
  FAILED
}

/// Reembolso de um pedido pago. GATEWAY devolve pelo gateway (Mercado Pago); MANUAL registra um estorno feito fora do sistema.
model Refund {
  id              String       @id @default(uuid())
  storeId         String
  orderId         String
  paymentId       String
  amount          Decimal      @db.Decimal(14, 2)
  reason          String
  mode            RefundMode
  status          RefundStatus @default(PENDING)
  gatewayRefundId String?
  error           String?
  actorId         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([storeId, createdAt(sort: Desc)])
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id              String             @id @default(uuid())
  storeId         String
  code            String
  description     String?
  type            CouponType
  value           Decimal            @default(0) @db.Decimal(14, 2)
  minSubtotal     Decimal?           @db.Decimal(14, 2)
  maxUses         Int?
  usedCount       Int                @default(0)
  oncePerCustomer Boolean            @default(false)
  firstOrderOnly  Boolean            @default(false)
  productIds      String[]           @default([])
  categoryIds     String[]           @default([])
  campaign        String?
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  store           Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  redemptions     CouponRedemption[]

  @@unique([storeId, code])
}

model CouponRedemption {
  id         String   @id @default(uuid())
  couponId   String
  orderId    String   @unique
  customerId String?
  amount     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, customerId])
}

model Brand {
  id        String    @id @default(uuid())
  storeId   String
  name      String
  slug      String
  logoUrl   String?
  createdAt DateTime  @default(now())
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([storeId, slug])
}

model Collection {
  id          String              @id @default(uuid())
  storeId     String
  name        String
  slug        String
  description String?
  active      Boolean             @default(true)
  position    Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    CollectionProduct[]

  @@unique([storeId, slug])
  @@index([storeId, position])
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

enum LoyaltyEntryType {
  EARN
  REVERSAL
  REDEEM
  ADJUST
}

/// Livro-razão de pontos: o saldo é a soma dos lançamentos, então nunca fica fora de sincronia com o histórico.
model LoyaltyEntry {
  id         String           @id @default(uuid())
  storeId    String
  customerId String
  orderId    String?
  type       LoyaltyEntryType
  points     Int
  note       String?
  actorId    String?
  createdAt  DateTime         @default(now())
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([orderId, type])
  @@index([storeId, customerId, createdAt])
}

/// Página institucional editável pelo lojista (Sobre, Trocas e devoluções, Privacidade…).
model Banner {
  id             String    @id @default(uuid())
  storeId        String
  imageUrl       String
  mobileImageUrl String?
  title          String?
  subtitle       String?
  ctaLabel       String?
  linkUrl        String?
  position       Int       @default(0)
  active         Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, active, position])
}

model NewsletterSubscriber {
  id             String    @id @default(uuid())
  storeId        String
  email          String
  name           String?
  source         String    @default("site")
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, email])
  @@index([storeId, createdAt])
}

model Menu {
  id        String   @id @default(uuid())
  storeId   String
  key       String
  items     Json
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
}

model Page {
  id             String   @id @default(uuid())
  storeId        String
  slug           String
  title          String
  body           String
  published      Boolean  @default(false)
  showInFooter   Boolean  @default(true)
  position       Int      @default(0)
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId, published, position])
}

enum EmailStatus {
  SENT
  SIMULATED
  FAILED
}

/// Registro de cada e-mail transacional: o que foi (ou seria) enviado, para quem e o resultado.
model EmailLog {
  id         String      @id @default(uuid())
  storeId    String
  eventId    String?
  template   String
  toEmail    String
  subject    String
  body       String
  status     EmailStatus
  error      String?
  providerId String?
  createdAt  DateTime    @default(now())
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

enum PromotionType {
  PERCENT_OFF
  BUY_X_PAY_Y
  CART_PERCENT
}

/// Desconto automático (sem código): aplicado pela loja a quem cumpre a regra.
model Promotion {
  id          String        @id @default(uuid())
  storeId     String
  name        String
  type        PromotionType
  value       Decimal       @default(0) @db.Decimal(5, 2)
  buyQty      Int?
  payQty      Int?
  minSubtotal Decimal?      @db.Decimal(14, 2)
  skus        String[]
  active      Boolean       @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, active])
}

/// Imagem enviada pelo painel quando não há bucket R2 configurado; servida por GET /media/:id.
model MediaAsset {
  id        String   @id @default(uuid())
  storeId   String
  kind      String
  mime      String
  size      Int
  width     Int?
  height    Int?
  name      String?
  data      Bytes
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

enum BlingSyncStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum BlingImportStatus {
  RUNNING
  DONE
  FAILED
}

enum BlingInvoiceStatus {
  QUEUED
  PROCESSING
  GENERATED
  AUTHORIZED
  REJECTED
  FAILED
}

enum BlingWebhookStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

/// Conta do Bling conectada por OAuth; os tokens ficam cifrados (AES-256-GCM).
model BlingConnection {
  id              String   @id @default(uuid())
  storeId         String   @unique
  companyId       String?
  accessTokenEnc  String
  refreshTokenEnc String
  expiresAt       DateTime
  connectedAt     DateTime @default(now())
  lastError       String?
  automaticInvoiceEnabled Boolean @default(false)
  automaticInvoiceEnabledAt DateTime?
  stockSyncEnabled Boolean @default(false)
  stockSyncedAt   DateTime?
  stockSyncError  String?
  updatedAt       DateTime @updatedAt
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invoices        BlingInvoice[]

  @@index([companyId])
}

/// Um pedido do site enviado (ou a enviar) ao Bling; `numeroLoja` no Bling é o número do pedido daqui.
model BlingOrderSync {
  id            String          @id @default(uuid())
  storeId       String
  orderId       String          @unique
  status        BlingSyncStatus @default(PENDING)
  blingOrderId  String?
  blingOrderNumber String?
  blingSituationId String?
  blingSituationName String?
  attempts      Int             @default(0)
  lastError     String?
  nextAttemptAt DateTime        @default(now())
  sentAt        DateTime?
  /// Quando o pedido pago foi baixado no Bling (estoque e contas lançados, situação Atendido).
  postedAt      DateTime?
  postError     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  store         Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([storeId, blingOrderId])
}

/// Caixa de entrada idempotente dos webhooks autenticados do Bling.
model BlingWebhookEvent {
  id            String             @id @default(uuid())
  eventId       String             @unique
  companyId     String
  event         String
  version       String             @default("v1")
  remoteId      String
  orderNumber   String?
  payload       Json
  status        BlingWebhookStatus @default(PENDING)
  attempts      Int                @default(0)
  lastError     String?
  nextAttemptAt DateTime           @default(now())
  receivedAt    DateTime           @default(now())
  processedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, nextAttemptAt, receivedAt])
  @@index([companyId, receivedAt])
}

/// Nota fiscal originada do pedido de venda Bling; número do pedido da loja permanece como chave de idempotência.
model BlingInvoice {
  id              String             @id @default(uuid())
  storeId         String
  orderId         String             @unique
  connectionId    String
  status          BlingInvoiceStatus @default(QUEUED)
  blingInvoiceId  String?            @unique
  invoiceNumber   String?
  series          String?
  accessKey       String?
  danfeUrl        String?            @db.Text
  xmlUrl          String?            @db.Text
  rejectionReason String?            @db.Text
  attempts        Int                @default(0)
  nextAttemptAt   DateTime           @default(now())
  issuedAt        DateTime?
  submittedAt     DateTime?
  authorizedAt    DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  store           Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order           Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  connection      BlingConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([storeId, status, nextAttemptAt])
  @@index([storeId, invoiceNumber])
}

/// Importação de produtos do Bling: roda em segundo plano e o painel acompanha o andamento.
model BlingImport {
  id         String            @id @default(uuid())
  storeId    String
  status     BlingImportStatus @default(RUNNING)
  total      Int               @default(0)
  processed  Int               @default(0)
  created    Int               @default(0)
  updated    Int               @default(0)
  failed     Int               @default(0)
  skipped    Int               @default(0)
  /// new = só cria o que falta; update = também atualiza dados descritivos, sem mexer em preço, situação e estoque
  mode       String            @default("new")
  errors     Json              @default("[]")
  startedAt  DateTime          @default(now())
  finishedAt DateTime?
  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, startedAt])
}

enum DomainStatus {
  PENDING_DNS
  DNS_VERIFIED
  ACTIVE
  ERROR
}

/// Domínio próprio da loja. ACTIVE só depois de provar posse (TXT) e de o HTTPS responder com certificado válido.
model StoreDomain {
  id                String       @id @default(uuid())
  storeId           String
  hostname          String       @unique
  status            DomainStatus @default(PENDING_DNS)
  verificationToken String
  isPrimary         Boolean      @default(false)
  dnsVerifiedAt     DateTime?
  tlsValidUntil     DateTime?
  lastCheckedAt     DateTime?
  lastError         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  store             Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

enum AbandonedCartStatus {
  OPEN
  REMINDED
  RECOVERED
  OPTED_OUT
}

/// Carrinho de quem informou o e-mail no checkout e não concluiu o pedido. Um por loja e e-mail.
model AbandonedCart {
  id               String              @id @default(uuid())
  storeId          String
  email            String
  name             String?
  /// Itens no formato do carrinho da vitrine, montados pelo servidor a partir do catálogo.
  items            Json
  itemCount        Int
  subtotal         Decimal             @db.Decimal(14, 2)
  /// Segredo do link de recuperação e de descadastro enviado por e-mail.
  token            String              @unique @default(uuid())
  status           AbandonedCartStatus @default(OPEN)
  lastActivityAt   DateTime            @default(now())
  remindedAt       DateTime?
  recoveredAt      DateTime?
  recoveredOrderId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  store            Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, email])
  @@index([storeId, status, lastActivityAt])
}

/// Dados do checkout ainda não concluído, gravados a cada campo para o cliente não perder o que digitou.
/// O token fica só no navegador do cliente; o registro some ao fechar o pedido ou após 30 dias sem uso.
model CheckoutDraft {
  id        String   @id @default(uuid())
  storeId   String
  token     String   @unique
  /// CPF só com dígitos, para reencontrar o rascunho quando o cliente volta em outro aparelho.
  cpf       String?
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, cpf])
  @@index([updatedAt])
}

/// Texto personalizado de um e-mail da loja (chave = modelo padrão no código). Sem linha, vale o padrão.
model EmailTemplate {
  id        String   @id @default(uuid())
  storeId   String
  key       String
  subject   String
  body      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
}

enum EmailCampaignStatus {
  DRAFT
  SENDING
  SENT
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  SENDING
  SENT
  SIMULATED
  FAILED
}

model EmailCampaign {
  id         String                @id @default(uuid())
  storeId    String
  name       String
  subject    String
  body       String
  audience   String                @default("ALL")
  segment    String?
  status     EmailCampaignStatus   @default(DRAFT)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  store      Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  recipients EmailCampaignRecipient[]

  @@index([storeId, createdAt])
  @@index([status])
}

model EmailCampaignRecipient {
  id         String                  @id @default(uuid())
  campaignId String
  email      String
  name       String?
  status     CampaignRecipientStatus @default(PENDING)
  attempts   Int                     @default(0)
  claimedAt  DateTime?
  sentAt     DateTime?
  error      String?
  campaign   EmailCampaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([campaignId, status])
}

/// Anotação interna datada sobre o cliente (atendimento, combinados), com o autor.
model CustomerNote {
  id         String   @id @default(uuid())
  storeId    String
  customerId String
  authorId   String?
  authorName String
  body       String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId, customerId, createdAt])
}

/// Depósito/loja física. O padrão guarda o "restante" (saldo total menos os outros depósitos),
/// por isso pedidos, devoluções e a sincronização com o ERP continuam mexendo só no saldo total.
model Warehouse {
  id        String           @id @default(uuid())
  storeId   String
  name      String
  code      String
  isDefault Boolean          @default(false)
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stocks    WarehouseStock[]

  @@unique([storeId, code])
}

/// Saldo de um item num depósito que não é o padrão.
model WarehouseStock {
  id          String    @id @default(uuid())
  storeId     String
  warehouseId String
  inventoryId String
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, inventoryId])
  @@index([inventoryId])
}

/// Histórico de transferências entre depósitos (nomes guardados para sobreviver à exclusão).
model WarehouseTransfer {
  id            String   @id @default(uuid())
  storeId       String
  productId     String
  variantId     String?
  fromWarehouse String
  toWarehouse   String
  quantity      Int
  reason        String?
  actorId       String?
  createdAt     DateTime @default(now())

  @@index([storeId, createdAt])
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  SKIPPED
}

/// Regra "quando acontecer X (gatilho), se Y (condições), esperar Z minutos e fazer W (ações)".
model AutomationRule {
  id           String          @id @default(uuid())
  storeId      String
  name         String
  active       Boolean         @default(false)
  trigger      String
  conditions   Json            @default("{}")
  delayMinutes Int             @default(0)
  actions      Json
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@index([storeId, trigger, active])
}

/// Uma execução de regra para um evento. A chave (regra, evento) garante que o mesmo evento nunca dispara a regra duas vezes.
model AutomationRun {
  id         String              @id @default(uuid())
  storeId    String
  ruleId     String
  eventId    String
  orderId    String?
  customerId String?
  status     AutomationRunStatus @default(PENDING)
  runAt      DateTime
  startedAt  DateTime?
  finishedAt DateTime?
  attempts   Int                 @default(0)
  /// Progresso das ações (quantas já foram feitas e o cupom criado), para uma nova tentativa não repetir efeitos.
  state      Json                @default("{}")
  result     String?
  createdAt  DateTime            @default(now())
  rule       AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, eventId])
  @@index([status, runAt])
  @@index([storeId, createdAt])
}

/// Regras do programa de pontos de cada loja (uma linha por loja; sem linha valem os padrões).
model LoyaltyConfig {
  storeId       String   @id
  enabled       Boolean  @default(true)
  pointsPerReal Decimal  @default(1) @db.Decimal(8, 2)
  realPerPoint  Decimal  @default(0.05) @db.Decimal(8, 4)
  minRedeem     Int      @default(1)
  silverFrom    Int      @default(500)
  goldFrom      Int      @default(2000)
  diamondFrom   Int      @default(5000)
  silverPct     Int      @default(100)
  goldPct       Int      @default(100)
  diamondPct    Int      @default(100)
  updatedAt     DateTime @updatedAt
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

/// Endereço antigo que leva ao novo com redirecionamento permanente (301), para não perder posição no Google ao trocar de loja.
model Redirect {
  id        String   @id @default(uuid())
  storeId   String
  fromPath  String
  toPath    String
  hits      Int      @default(0)
  lastHitAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, fromPath])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Avaliação de produto feita por quem comprou (pedido pago); só aparece na loja depois de aprovada pelo lojista.
model ProductReview {
  id         String       @id @default(uuid())
  storeId    String
  productId  String
  orderId    String
  customerId String?
  authorName String
  rating     Int
  title      String?
  body       String
  status     ReviewStatus @default(PENDING)
  reply      String?
  repliedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
  @@index([storeId, status, createdAt])
  @@index([productId, status])
}
