POSTGRES_DB=storeos
POSTGRES_USER=storeos
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://storeos:change-me-in-production@postgres:5432/storeos?schema=public
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://storeos:change-me-in-production@rabbitmq:5672
JWT_ACCESS_SECRET=replace-with-a-64-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-character-secret
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_STORE_SLUG=demo
SEED_ADMIN_EMAIL=admin@demo.storeos.dev
SEED_ADMIN_PASSWORD=change-me-before-seeding
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Chave pública do Mercado Pago: habilita cartão de crédito com parcelas no checkout
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_MAX_INSTALLMENTS=12
# Limite máximo sem juros exibido (as condições precisam estar habilitadas na conta Mercado Pago).
MERCADOPAGO_MAX_FREE_INSTALLMENTS=1
# Bling (ERP): crie um aplicativo no Bling e use API_PUBLIC_URL/api/v1/bling/callback como link de redirecionamento
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# Cartão pela Rede (e.Rede): PV (filiação) e token de integração; REDE_SANDBOX=true usa o ambiente de testes
REDE_PV=
REDE_TOKEN=
REDE_SANDBOX=true
REDE_SOFT_DESCRIPTOR=
REDE_MIN_INSTALLMENT=5
API_PUBLIC_URL=http://localhost:3001
PIX_EXPIRATION_MINUTES=60

# E-mails transacionais: sem RESEND_API_KEY os e-mails só são registrados (modo simulado).
RESEND_API_KEY=
MAIL_FROM=Minha Loja <pedidos@meudominio.com.br>
# Frete em tempo real: SuperFrete (preferido) ou Melhor Envio. Precisa do token e do CEP de onde a loja despacha.
SUPERFRETE_TOKEN=
SUPERFRETE_SANDBOX=false
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=false
SHIPPING_ORIGIN_ZIP=

# Criação da loja e do dono na subida da API (idempotente; não troca senha existente).
# Remova BOOTSTRAP_OWNER_PASSWORD depois do primeiro deploy.
BOOTSTRAP_STORE_SLUG=
BOOTSTRAP_STORE_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_PASSWORD=
